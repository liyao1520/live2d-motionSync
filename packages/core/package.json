{
  "name": "@live2d-motionsync/core",
  "version": "2.0.0-alpha.0",
  "type": "module",
  "description": "Live2D rendering and audio-driven lip synchronization for modern browsers",
  "license": "SEE LICENSE IN THIRD_PARTY_NOTICES.md",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "prepare:runtime": "node ../../scripts/prepare-runtime.mjs",
    "build": "pnpm prepare:runtime && tsdown",
    "typecheck": "pnpm prepare:runtime && tsc --noEmit",
    "prepublishOnly": "node ../../scripts/check-publication.mjs"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "pixi.js": "8.20.1",
    "untitled-pixi-live2d-engine": "1.3.5"
  }
}
