{
  "name": "live2d-motionsync-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "build": "pnpm --filter @live2d-motionsync/core build",
    "dev": "pnpm --filter playground dev",
    "typecheck": "pnpm --filter @live2d-motionsync/core typecheck",
    "test": "vitest run",
    "test:browser": "playwright test",
    "lint": "eslint packages/core/src packages/core/tests",
    "format": "prettier --write packages/core/src packages/core/tests",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "docs": "pnpm --filter docs dev",
    "test:package": "node scripts/pack-smoke.mjs",
    "test:examples": "node scripts/examples-smoke.mjs",
    "test:docs": "node scripts/docs-smoke.mjs",
    "build:examples": "pnpm --filter example-vanilla --filter example-react --filter example-vue --filter playground build",
    "build:docs": "pnpm --filter docs build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm check && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.8",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "eslint": "9.39.4",
    "globals": "16.5.0",
    "prettier": "3.8.1",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
